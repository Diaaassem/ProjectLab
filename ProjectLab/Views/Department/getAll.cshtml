@model List<Department>

<a href="/Department/AddDepartment" class="btn btn-primary" style="margin-top: 20px; margin-bottom: 10px;">
    <i class="bi bi-plus-lg"></i> Add New Department
</a>
<br /><br />

<table class="table">
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Name</th>
            <th scope="col">Manager</th>
            <th scope="col">Location</th>
            <th scope="col">Branch</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var dept in Model)
        {
            <tr>
                <td>@dept.DeptId</td>
                <td>@dept.Name</td>
                <td>@dept.Manager</td>
                <td>@dept.Location</td>
                <td>@dept.Branch</td>
                <td>
                    <a asp-controller="Department" asp-action="Edit" asp-route-id="@dept.DeptId" class="btn btn-warning btn-sm">Edit</a>
                    <a asp-controller="Department" asp-action="Delete" asp-route-id="@dept.DeptId" class="btn btn-danger btn-sm">Delete</a>
                </td>

            </tr>
        }
    </tbody>
</table>

