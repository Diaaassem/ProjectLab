@* @model Instructor *@

<h3 class="form-container">Add New Instructor</h3>

<div class="form-container">
    <div class="short-input">
        <form asp-action="AddNewInstructor" asp-controller="Instructor" method="post">
            <partial name="_InstructorFormPartial" model="Model" />
            <br />
            <div class="form-group">
                <button type="submit" class="btn btn-primary">Submit</button>
            </div>
        </form>
    </div>
</div>