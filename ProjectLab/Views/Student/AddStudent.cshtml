<style>
    .short-input {
        max-width: 360px;
        width: 100%;
        box-sizing: border-box;
    }

    .form-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }
</style>

<h3 class="form-container">Add New Student</h3>

<div class="form-container">
    <form action="/Student/AddNewStudent">
        <div class="form-group">
            <label for="exampleInputEmail1">Name</label>
            <input type="text" name="Name" class="form-control short-input" id="exampleInputEmail1" aria-describedby="emailHelp">
        </div>
        <div class="form-group">
            <label for="exampleInputPassword1">Age</label>
            <input type="number" name="Age" class="form-control short-input" id="exampleInputPassword1">
        </div>
        <div class="form-group">
            <label for="exampleInputLocation1">Image</label>
            <input type="text" name="Image" class="form-control short-input" id="exampleInputLocation1">
        </div>
        <div class="form-group">
            <label for="exampleInputBranch1">Address</label>
            <input type="text" name="Address" class="form-control short-input" id="exampleInputBranch1">
        </div>
        <div class="form-group">
            <label for="exampleInputEmail1">Email</label>
            <input type="text" name="Email" class="form-control short-input" id="exampleInputEmail1" aria-describedby="emailHelp">
        </div>
        <div>
            <label for="exampleInputDepartment1">Department ID</label>
            <input type="number" name="DeptId" class="form-control short-input" id="exampleInputDepartment1">
        </div>
        <br />

        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>