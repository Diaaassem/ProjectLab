@model Student

<h3 class="form-container">Edit Student</h3>

<div class="form-container">
    <form action="/Student/Edit" method="post">
        <input type="hidden" name="SSN" value="@Model.SSN" />
        <partial name="_StudentFormPartial" model="Model" />
        <br />
        <button type="submit" class="btn btn-primary">Submit</button>
    </form>
</div>