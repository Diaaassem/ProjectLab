@model Student

<style>
    .short-input {
        max-width: 360px;
        width: 100%;
        box-sizing: border-box;
    }

    .form-container {
        display: flex;
        justify-content: center;
        margin-top: 20px;
    }

    .form-group {
        margin-bottom: 10px;
    }
</style>

<div class="form-group">
    <label asp-for="Name"></label>
    <input asp-for="Name" class="form-control short-input" aria-describedby="nameHelp" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Age"></label>
    <input asp-for="Age" class="form-control short-input" />
    <span asp-validation-for="Age" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Image"></label>
    <input asp-for="Image" class="form-control short-input" />
    <span asp-validation-for="Image" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Address"></label>
    <input asp-for="Address" class="form-control short-input" />
    <span asp-validation-for="Address" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="Email"></label>
    <input asp-for="Email" class="form-control short-input" aria-describedby="emailHelp" />
    <span asp-validation-for="Email" class="text-danger"></span>
</div>
<div class="form-group">
    <label asp-for="DeptId">Department</label>
    <select asp-for="DeptId" asp-items="@(new SelectList(ViewBag.Departments, "DeptId", "Name"))" class="form-control short-input">
        <option value="">--Select Department--</option>
    </select>
    <span asp-validation-for="DeptId" class="text-danger"></span>
</div>
