@model List<Student>

<a asp-controller="Student" asp-action="AddStudent" class="btn btn-primary" style="margin-top: 20px; margin-bottom: 10px;">
    <i class="bi bi-plus-lg"></i> Add New Student
</a>

<br /> <br />



<table class="table">
    <thead>
        <tr>
            <th scope="col">SSN</th>
            <th scope="col">Name</th>
            <th scope="col">Age</th>
            <th scope="col">Image</th>
            <th scope="col">Address</th>
            <th scope="col">Email</th>
            <th scope="col">Action</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <th>@student.SSN</th>
                <td>@student.Name</td>
                <td>@student.Age</td>
                <td><img src="@student.Image" alt="@student.Image" /></td>
                <td>@student.Address</td>
                <td>@student.Email</td>
                <td>
                    <a asp-controller="Student" asp-action="Edit" asp-route-id="@student.SSN" class="btn btn-warning btn-sm">Edit</a>
                    <form asp-controller="Student" asp-action="Delete" method="post" style="display:inline;">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@student.SSN" />
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>